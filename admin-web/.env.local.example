# Copy to .env.local and fill in. These two are PUBLIC (safe in the browser).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — used ONLY by scripts/import-content.mjs (never shipped to the browser).
# Keep this secret. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
