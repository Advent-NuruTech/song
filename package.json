{
  "name": "advent-pro",
  "main": "expo-router/entry",
  "version": "1.2.0",
  "engines": {
    "node": "^20.19.0 || ^22.0.0 || ^24.0.0"
  },
  "scripts": {
    "content:bundle": "node ./scripts/build-content-bundles.js",
    "prestart": "npm run content:bundle",
    "start": "expo start",
    "prestart:phone": "npm run content:bundle",
    "start:phone": "expo start --go --offline",
    "prestart:tunnel": "npm run content:bundle",
    "start:tunnel": "expo start --go --tunnel",
    "prestart:clear": "npm run content:bundle",
    "start:clear": "expo start --go --lan --clear",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android:test": "npx eas-cli@latest build --platform android --profile preview",
    "build:android:play": "npx eas-cli@latest build --platform android --profile production",
    "lint": "expo lint",
    "validate:content": "node ./scripts/validate-content-json.js",
    "test:media": "node --experimental-strip-types ./scripts/validate-media.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "^7.1.8",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.45.4",
    "expo": "~54.0.37",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-file-system": "~19.0.24",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.22",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "react-native-youtube-iframe": "2.4.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "~54.0.11",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
