{
  "id": "LUO_022",
  "hymnNumber": 22,
  "title": "Kik Ibarna, Yaye Jakonya",
  "language": "luo",
  "author": "",
  "stanzas": [
    [
      "Kik ibarna, yaye Jakonya,",
      "Winji yuak mara;",
      "In Kiluongo jo mamagi,",
      "Mond' iluonga be."
    ],
    [
      "An kaparo ng'wono mari chunya yudo kuwe;",
      "Ka agoni chonga piny ka,",
      "Jawarna, Konya."
    ],
    [
      "An ageno nyingi kende,",
      "Adwaro neni;",
      "Changi chunya moseketho,",
      "Wara gi rembi."
    ],
    [
      "Miwaso ohewa kodi,",
      "To agombi nga'ng;",
      "Ere ng'a maromo kodi",
      "E piny gi polo?"
    ]
  ],
  "chorus": [
    "Yesu, Yesu, Winji yuak mara;",
    "In Kiluongo jo mamagi, mond' iluonga be."
  ]
}