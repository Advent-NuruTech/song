{
  "id": "LUO_004",
  "hymnNumber": 4,
  "title": "Nying Yesu Mondo Yudi Pak",
  "language": "luo",
  "author": "Oliver Holden",
  "stanzas": [
    [
      "Nying Yesu ,mondo yudi pak,",
      "Ji mondo gidende;",
      "Malaika me polo ku,",
      "Miuru Ruodhu duong',"
    ],
    [
      "Miuru! Ruodh duong'e chunyu,",
      "Geneuru kende;",
      "Ting' nyinge malo kuom jopiny,",
      "Miuru Ruodhu duong'"
    ],
    [
      "Un jo moketho, paruru,",
      "Kaka nogur Yesu;",
      "Nowaru gi rembe maler,",
      "Miuru Ruodhu duong'"
    ],
    [
      "Un jo mong'eyo ng'wono Ruoth,",
      "Un ma koth Israel,",
      "Hereuru, pake gi wer,",
      "Miuru Ruoth duong'"
    ]
  ],
  "chorus": ""
}