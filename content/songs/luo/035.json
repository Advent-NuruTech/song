{
  "id": "LUO_035",
  "hymnNumber": 35,
  "title": "Paruru Nying Yesu Koro",
  "language": "luo",
  "author": "",
  "stanzas": [
    [
      "Paruru nying Yesu koro,",
      "Un jopiny machandore;",
      "En nomiu doko mamor,",
      "Paruru nyinge koro."
    ],
    [
      "Paruru nying Yesu pile,",
      "Enogeng'nu maricho;",
      "Ka orwakowa gi ng'uono,",
      "Paruru nying Yesu Ruoth."
    ],
    [
      "Paruru Yeus koro,",
      "E manyalo konyou;",
      "Ka orwakowa gi ng'uono,",
      "Paruru nying Yesu Yesu Ruoth."
    ],
    [
      "En Ruoth ruothi, wanadende",
      "Ka wagone chonge piny,",
      "Kucha e pinyruoth mar polo,",
      "Ka wuodhwa me piny rumo."
    ]
  ],
  "chorus": [
    "Nyinge ber..moloyo.",
    "Nyingeno wagen ka;",
    "Nyinge ber..moloyo. (Nyinge ber, Ober moloyo)",
    "Nyingeno wageno ka."
  ]
}