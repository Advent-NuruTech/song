{
  "id": "LUO_016",
  "hymnNumber": 16,
  "title": "Ruoth Maler, Adwari Pile",
  "language": "luo",
  "author": "",
  "stanzas": [
    [
      "Ruoth maler, adwari pile!",
      "An a yom, an ng'a marach;",
      "Mak lueta kitaya pile,",
      "Tekona nayud kuomi."
    ],
    [
      "Chuny mamuol mondo imiya;",
      "Richo osekethoa;",
      "Puonja mondo ang'e yomna,",
      "An akwayi tekoni."
    ],
    [
      "Ok naluor kitaya pile;",
      "To kenda nagora piny;",
      "Wuoth koda, yaye Jokonya,",
      "In lerna, In ngimana."
    ],
    [
      "Kata gi manade biro, kata mor, kata kuyo,",
      "Chunya pod otwere kuomi,",
      "In Jakonya saa duto."
    ]
  ],
  "chorus": [
    "Saa duto, Saa duto, Ruoth Maler, adwari pile;",
    "Saa duto, Saa duto, Ruoth, rita saa duto."
  ]
}