{
  "id": "ENG_479",
  "hymnNumber": 479,
  "title": "Tread Softly",
  "language": "english",
  "author": "",
  "stanzas": [
    [
      "Be silent, be silent,",
      "A whisper is heard;",
      "Be silent, and listen,",
      "Oh treasure each word."
    ],
    [
      "Be silent, be silent,",
      "For holy this place,",
      "This altar that echoes",
      "The message of grace."
    ],
    [
      "Be silent, be silent,",
      "Breathe humbly our prayer;",
      "A foretaste of Eden",
      "This moment we share."
    ],
    [
      "Be silent, be silent,",
      "His mercy record;",
      "Be silent, be silent,",
      "And wait on the Lord."
    ]
  ],
  "chorus": [
    "Tread softly, tread softly, The Master is here;",
    "Tread softly, tread softly, He bids us draw near."
  ]
}