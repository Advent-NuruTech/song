{
  "id": "ENG_069",
  "hymnNumber": 69,
  "title": "Lord, Make Us More Holy",
  "language": "english",
  "author": "",
  "stanzas": [
    [
      "Lord, make us more holy;",
      "Lord, make us more holy;",
      "Lord, make us more holy",
      "Until we meet again."
    ],
    [
      "Lord, make us more faithful;",
      "Lord, make us more faithful;",
      "Lord, make us more faithful",
      "Until we meet again."
    ],
    [
      "Lord, make us more humble;",
      "Lord, make us more humble;",
      "Lord, make us more humble",
      "Until we meet again."
    ],
    [
      "Lord, make us more loving;",
      "Lord, make us more loving;",
      "Lord, make us more loving",
      "Until we meet again.",
      "Like Jesus, the Savior,",
      "Until we meet again."
    ]
  ],
  "chorus": ""
}