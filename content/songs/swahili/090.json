{
  "id": "SWA_090",
  "hymnNumber": 90,
  "title": "Mapya Ni Mapenzi",
  "language": "swahili",
  "author": "",
  "stanzas": [
    [
      "Mapya ni mapenzi hayo, Asubuhi tuonayo;",
      "Saa za giza hulindwa, Kwa uzima kuamka."
    ],
    [
      "Kila saku, mapya pia, Rehema, wema na afya,",
      "Wokovu na msamaha, Mawazo mema, furaha."
    ],
    [
      "Tukijitahidi leo, Na mwendo utupasao,",
      "Mungu atatueleza,",
      "Yatakayompendeza."
    ],
    [
      "Mamboyetu ya dunia,",
      "Bwana atayang'aria,",
      "Matata atageuza,",
      "Yawe kwetu ya baraka."
    ],
    [
      "Yaliyo madogo, haya,",
      "Bwana tukimfanyia,",
      "Yatosha: tutafaidi,",
      "Huvuta kwake zaidi."
    ],
    [
      "Ewe Bwana, siku zote,",
      "Tusaidie kwa yote:",
      "Mwendo wetu wote vivyo,",
      "Uwe kama tuombavyo."
    ]
  ],
  "chorus": ""
}
