{
  "expo": {
    "name": "Advent Pro",
    "slug": "advent-pro",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "adventpro",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.adventpro"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground-v1.2.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.adventpro"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-logo-transparent.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      "expo-sqlite",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#0B4AA6",
          "defaultChannel": "advent-pro-updates"
        }
      ],
      "./plugins/with-google-services-version",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Advent Pro to add images to your notes.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "10279f57-4ab4-42b7-a5bc-7bc53df7df1d"
      },
      "supabaseUrl": "https://rrwicyoaulfcchltamxg.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJyd2ljeW9hdWxmY2NobHRhbXhnIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODE1NDE5OTIsImV4cCI6MjA5NzExNzk5Mn0.SbPXCZykUs5jiNcgvh1HUYKZSCvwJlje1PBCBRSOm_o"
    },
    "owner": "advent384"
  }
}
